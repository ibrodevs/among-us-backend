DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-local-only-do-not-use-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///db.sqlite3
# Required for production multi-worker ASGI; e.g. redis://localhost:6379/0
REDIS_URL=
# Production only: true behind a trusted TLS-terminating proxy which overwrites X-Forwarded-Proto
TRUST_PROXY_HTTPS=false
# Used by compose.yml; set a strong URL-safe secret in the real server environment
POSTGRES_PASSWORD=
