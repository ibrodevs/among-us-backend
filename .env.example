DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-local-only-do-not-use-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# SQLite is for isolated Stage A/API tests. Full matches require PostgreSQL, e.g. postgres://crew:<password>@localhost:5432/crew
DATABASE_URL=sqlite:///db.sqlite3
# Required for full matches across API + clock, including local development; e.g. redis://localhost:6379/0
REDIS_URL=
# Production only: true behind a trusted TLS-terminating proxy which overwrites X-Forwarded-Proto
TRUST_PROXY_HTTPS=false
# Used by compose.yml; set a strong URL-safe secret in the real server environment
POSTGRES_PASSWORD=

# Northflank API service: api; clock service: worker; one-off migration job: migrate
SERVICE_ROLE=api
PORT=8000
# Tune separately: API max 8, worker max 4; each process also needs the leader session.
DB_POOL_MIN=1
DB_POOL_MAX=8
# True for Supabase/external production database. Use a DIRECT or SESSION pooler URL.
DATABASE_REQUIRE_TLS=false
# Mount the Supabase CA as a secret file to enable sslmode=verify-full.
DATABASE_SSLROOTCERT=
# Optional aggregate counters written locally; no payloads or credentials included.
GAME_METRICS_ENABLED=false
GAME_METRICS_DIR=/tmp
WORKER_HEALTH_FILE=/tmp/crewmate-x-worker-health.json
